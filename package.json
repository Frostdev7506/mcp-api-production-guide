{
  "name": "mcp-support-reference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --env-file=.env --test dist/test/*.test.js",
    "dev": "npm run build && node --env-file=.env dist/src/main.js",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "setup:env": "node scripts/setup-env.mjs",
    "setup:auth": "node --env-file=.env --experimental-strip-types scripts/configure-auth.ts",
    "demo:local": "node scripts/filesystem-demo.mjs",
    "migrate": "node scripts/migrate.mjs",
    "inspector": "node node_modules/@modelcontextprotocol/inspector/clients/launcher/build/index.js --web --config inspector-session.json",
    "stage:vercel": "node scripts/stage-vercel.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.12.0",
    "@modelcontextprotocol/server-filesystem": "2.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
