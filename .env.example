# For LOCAL setup, run npm run setup:env instead of copying this file.
# This file documents names only. Never reuse placeholders as credentials.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
SUPPORT_DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_SECRET
DELEGATION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
DATABASE_URL=postgresql://support_app:REPLACE_ME@127.0.0.1:5547/support
API_URL=http://127.0.0.1:4310
MCP_URL=http://127.0.0.1:4311/mcp
OAUTH_ISSUER=http://127.0.0.1:8187/realms/support-demo
APP_MODE=local
# Hosted MCP entry only: same claim name as your Auth0 Action.
# OAUTH_TENANT_CLAIM=https://YOUR_MCP_HOST/tenant_id
# Migration command only; never place owner credentials in runtime services.
# MIGRATION_DATABASE_URL=postgresql://MIGRATION_OWNER:REPLACE_ME@YOUR_DB/support?sslmode=verify-full
